# Copy to server/.env (gitignored). `pnpm dev` loads it automatically.

# Required for in-game image search. Never sent to clients.
PIXABAY_KEY=

# Shared cut library. Leave these unset in dev to store cuts on local disk
# under server/data/cuts/ instead of R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=smoosh-assets
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Where blocklist.json, reports.jsonl and local cuts live (default: server/data)
# MEDIA_DATA_DIR=

# --- /admin: prompts, labels, logs. Admin sign-in only — players never sign in.
# Full setup, and the break-glass fallback: ADMIN.md at the repo root.

# Google accounts allowed in. The base list gets prompts and labels; the logs
# list is a subset of it and adds logs (device models, room codes, player
# names). Comma-separated. Changes take a restart.
ADMIN_EMAILS=
ADMIN_LOGS_EMAILS=

# Google OAuth client (Web application). Authorised redirect URI:
# <ADMIN_ORIGIN>/api/admin/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# where the admin page is served: https://<the Worker's domain>, or
# http://localhost:5173 in dev (no trailing slash)
ADMIN_ORIGIN=
# signs the session cookie; 32+ characters (openssl rand -base64 32).
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# BREAK GLASS — the last resort when Google sign-in is broken. 32+ characters,
# kept in your password manager. Opens /admin/break-glass for an hour; every
# use is logged loudly. Unset: no fallback. See ADMIN.md.
ADMIN_BREAK_GLASS_TOKEN=

# For pnpm labels:pull / labels:push on the laptop (tools/.env has the same
# value). Machine to machine; never typed into a browser. 32+ characters.
LABELS_SYNC_KEY=

# A PRIVATE R2 bucket for the prompt list (the assets bucket above is public,
# so the list must not go there). Unset: stored in the data dir on disk.
R2_PROMPTS_BUCKET=
