# Copy to server/.env (gitignored). `pnpm dev` loads it automatically.

# Required for in-game image search. Never sent to clients.
PIXABAY_KEY=

# Shared cut library. Leave these unset in dev to store cuts on local disk
# under server/data/cuts/ instead of R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=smoosh-assets
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Where blocklist.json, reports.jsonl and local cuts live (default: server/data)
# MEDIA_DATA_DIR=
